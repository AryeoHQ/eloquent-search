{
    "name": "aryeo/eloquent-search",
    "description": "A package to add search, filtering, and sorting to Eloquent models.",
    "keywords": [
        "Aryeo",
        "laravel",
        "eloquent"
    ],
    "homepage": "https://github.com/aryeohq/eloquent-search",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rob Fonseca",
            "email": "robfo@zillowgroup.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "aryeo/primitives": "0.0.15",
        "aryeo/tooling-laravel": "0.0.43",
        "directorytree/opensearch-adapter": "^1.2",
        "directorytree/opensearch-client": "^1.0",
        "directorytree/opensearch-migrations": "^1.1",
        "directorytree/opensearch-scout-driver": "^1.1",
        "laravel/framework": "^12.36 || ^13",
        "laravel/scout": "^10",
        "nikic/php-parser": "^5.7",
        "opensearch-project/opensearch-php": "^2.6",
        "phpstan/phpstan": "^2.1"
    },
    "require-dev": {
        "brianium/paratest": "^7.14",
        "orchestra/testbench": "^10.6 || ^11",
        "orchestra/testbench-core": "^10.7 || ^11",
        "phpunit/phpunit": "^12.5 || ^13",
        "rector/rector": "^2.1"
    },
    "repositories": {
        "artifactory": {
            "type": "composer",
            "url": "https://artifactory.zgtools.net/artifactory/api/composer/listing-and-vendor-management-composer/",
            "only": ["aryeo/*", "zillow/*"]
        }
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/Support/",
            "Tooling\\": "src/Tooling/"
        },
        "exclude-from-classmap": [
            "*Test.php",
            "*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "vendor/orchestra/testbench-core/laravel/app/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "aryeo/tooling-laravel": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Search\\Providers\\Provider"
            ]
        },
        "tooling": {
            "phpstan": {
                "rules": "tooling/phpstan/rules.neon",
                "config": {
                    "paths": ["src", "tests/Fixtures/Support"]
                }
            },
            "rector": {
                "configured_rules": "tooling/rector/configured-rules.php",
                "config": {
                    "paths": ["src"]
                }
            },
            "pint": {
                "config": {
                    "paths": ["src", "tests"]
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
