{
    "name": "aryeo/eloquent-search",
    "description": "Laravel package providing OpenSearch Scout integration, index migration tooling, and PHPStan guardrails for Aryeo search models.",
    "keywords": [
        "Aryeo",
        "laravel",
        "opensearch",
        "scout"
    ],
    "homepage": "https://github.com/aryeohq/eloquent-search",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aryeo",
            "email": "support@aryeo.com",
            "role": "Organization"
        }
    ],
    "require": {
        "php": "^8.4",
        "aryeo/primitives": "*",
        "directorytree/opensearch-adapter": "^1.1",
        "directorytree/opensearch-migrations": "^1.1",
        "directorytree/opensearch-scout-driver": "^1.1",
        "illuminate/contracts": "^12.0",
        "laravel/scout": "^10.0"
    },
    "require-dev": {
        "aryeohq/phpstan-rules": "^1.1",
        "brianium/paratest": "^7.8",
        "canvural/larastan-strict-rules": "^3.0",
        "ergebnis/phpstan-rules": "^2.8",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "orchestra/testbench-core": "^10.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Support\\Search\\": "src/Support/Search/",
            "Tooling\\EloquentSearch\\": "src/Tooling/EloquentSearch/"
        },
        "exclude-from-classmap": [
            "*Test.php",
            "*TestCases.php",
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --configuration=phpstan.package.neon"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\Search\\Scout\\Providers\\SearchServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
